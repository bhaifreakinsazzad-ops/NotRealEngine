NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for validated anonymous brief intake; never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYMENTS_ENABLED=false
NOTIFICATIONS_ENABLED=false
SENTRY_DSN=

# Governs the DB-trigger-enforced staging/production split (terms, financial clearance).
# Unset or any value other than "staging" fails closed to production behavior. Set to
# "staging" only on Preview/staging deployments, never on the production deployment.
ENGINE_OS_ENV=production

# Server-only. Salts the rate-limit fingerprint hash for the native project-brief intake
# endpoint (app/api/project-briefs/route.ts). Falls back to SUPABASE_SERVICE_ROLE_KEY if unset,
# but should be its own independent secret in any real deployment.
RATE_LIMIT_SECRET=

# Server-only. Mandatory shared secret for the LeadConnector/GoHighLevel inbound webhook
# (app/api/webhooks/leadconnector/route.ts). If unset, that endpoint rejects every request —
# there is no environment-based bypass. Generate a random 32+ byte value and configure the
# same value as a custom header in the GoHighLevel Workflow Webhook action.
LEADCONNECTOR_WEBHOOK_SECRET=
